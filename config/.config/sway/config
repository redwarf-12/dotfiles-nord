# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu rofi

### Key bindings
#
# Basics:
#
# Start a terminal
bindsym $mod+t exec $term

# Kill focused window
bindsym $mod+q kill

# Start your launcher
bindsym $mod+a exec $menu -show drun

# Start wlogout
bindsym Control+Mod1+Delete exec systemctl poweroff
bindsym Control+Mod1+r exec systemctl reboot
bindsym Control+Mod1+s exec systemctl suspend
bindsym Control+Mod1+h exec systemctl hibernate
bindsym $mod+l exec swaylock -c 000000

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

# Reload the configuration file
bindsym $mod+Shift+s reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaymsg exit
#
# Applications
#
bindsym $mod+b exec brave
bindsym $mod+e exec nautilus --new-window
#
# Moving around:
#
# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
#

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
# Note: workspaces can have any name you want, not just numbers.
# We just use 1-10 as the default.
#
# Layout stuff:
#
# Make the current focus fullscreen
bindsym $mod+f fullscreen
# Toggle floating focus window
bindsym $mod+w floating toggle
#
# Scratchpad:
#
# Sway has a "scratchpad", which is a bag of holding for windows.
# You can send windows there and get them back later.

# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through themr
bindsym $mod+minus scratchpad show
#
# Utilities:
#
# Sink volume raise optionally with --device
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
# Sink volume lower optionally with --device
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower --device alsa_output.pci-0000_11_00.4.analog-stereo.monitor
# Sink volume toggle mute
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
# Source volume toggle mute
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
#
# Capslock (If you don't want to use the backend)
bindsym --release Caps_Lock exec swayosd-client --caps-lock
#
# Brightness raise (optionally with --device, can be device name or wildcard)
bindsym XF86MonBrightnessUp exec swayosd-client --brightness +5 
# Brightness lower (optionally with --device, can be device name or wildcard)
bindsym XF86MonBrightnessDown exec swayosd-client --brightness -5
#
# Play/Pause current player
bindsym XF86AudioPlay exec swayosd-client --playerctl play-pause
# Next song for current player
bindsym XF86AudioNext exec swayosd-client --playerctl next
#
# Clipboard history
bindsym $mod+v exec cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy
#
# Screenshot
#
bindsym Print exec sh -c 'grim -g "$(slurp)" - | wl-copy && notify-send -i camera-photo "Screenshot" "Copied to clipboard"'
#
bindsym $mod+Print exec sh -c 'FILE="$HOME/Pictures/screenshots/$(date +"%Y-%m-%d_%H-%M-%S").png" && \
    grim -g "$(slurp)" "$FILE" && \
    notify-send -i "$FILE" "Screenshot" "Saved in ~/Pictures/screenshots"'
#
# Screen recording
#
bindsym $mod+Shift+c exec sh -c 'killall -SIGUSR1 gpu-screen-recorder &&\
    notify-send -i media-tape "Clip" "Saved in ~/Videos/Clips"'

#
bindsym $mod+Shift+r exec sh -c 'if [ $(find ~/Videos/recordings -type f -mmin -0.1 | wc -l) -gt 0 ];\
    then pkill -SIGRTMIN -f "^gpu-screen-recorder" && notify-send -i camera-video "Recording" "Saved in ~/Videos/recordings";\
    else pkill -SIGRTMIN -f "^gpu-screen-recorder"; fi;\
    [ -f /tmp/waybar_recorder ] && rm /tmp/waybar_recorder || touch /tmp/waybar_recorder; pkill -RTMIN+1 waybar'
#
# Wallpaper selector
bindsym $mod+Shift+w exec WP=$(zenity --file-selection --filename="$HOME/dotfiles-nord/wallpapers/") && printf "%s" "$WP" > "$HOME/.config/sway/current-wallpaper" && awww img "$WP" -t wave --transition-fps 60 --transition-angle 15
#

# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
#
bar {
    swaybar_command waybar
}
#
### On start:
    
# On screen display
exec swayosd-server

# Wallpaper manager daemon
exec awww-daemon

# Notification manager
exec dunst

# Clipboard history (text + images)
exec cliphist wipe
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
    
# Network manager and bluetooth applet
exec --no-startup-id nm-applet --indicator
exec --no-startup-id blueman-applet

# Better windows tiling
exec autotiling
    
# Polkit agent
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Udiskie (automatic mount)
exec udiskie --tray --notify

# Start replay buffer
exec gpu-screen-recorder -w screen -f 60 -a "default_output|default_input" -r 60 -c mp4 -o ~/Videos/clips -ro ~/Videos/recordings

### Floating windows
#
#
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable, resize set width 800 px height 600 px
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
for_window [app_id="kitty-floating"] floating enable, resize set width 800 px height 600 px
for_window [app_id="kitty-updates"] floating enable, resize set width 1200 px height 600 px
for_window [class="steam_app_.*"] inhibit_idle fullscreen

# use "swaymsg -t get_tree" to get app_id
#
### Graphics
#
# Window spacing
#
gaps inner 5
#
# Window border
#
default_border pixel 3
#
# Opacity
for_window [app_id=".*"] opacity set 0.95
for_window [class=".*"] opacity set 0.95

# Window color
#
# class                 border  backgr. text    indicator child_border
client.focused          #88c0d0 #434c5e #eceff4 #8fbcbb   #88c0d0
client.focused_inactive #88c0d0 #2e3440 #d8dee9 #4c566a   #4c566a
client.unfocused        #88c0d0 #2e3440 #d8dee9 #4c566a   #4c566a
client.urgent           #ebcb8b #ebcb8b #2e3440 #8fbcbb   #ebcb8b
#
# Cursor
#
seat seat0 xcursor_theme Nordzy-cursors 35
#
#

include ./inout
#
### Wallpaper inizialization
exec_always awww img --transition-type none "$(cat $HOME/.config/sway/current-wallpaper)"
#
include /etc/sway/config.d/*
