{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "$(find -L ${XDG_CONFIG_HOME:-$HOME/.config/fastfetch/current-icon} -maxdepth 1 -type f | shuf -n 1)",        
    "height": 12,
    "padding": {
      "top": 3,
      "left": 4,
      "right": 5
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "┌───────────────────── Software ─────────────────────┐", // `\u001b` is `\033`, or `\e`
        "outputColor": "blue"
    },
    {
      "key": "󰣇 OS",
      "keyColor": "blue",
      "type": "os"
    },
    {
      "key": "│ ├ Kernel",
      "keyColor": "blue",
      "type": "kernel"
    },
    {
      "key": "│ ├󰏗 Packages",
      "keyColor": "blue",
      "type": "packages"
    },
    {
        "type": "command",
        "key": "│ ├󱦟 OS Age",
      "keyColor": "blue",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
        "type": "uptime",
        "key": "└ └󱫐 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘", // `\u001b` is `\033`, or `\e`
        "outputColor": "blue"
    },
    "break",
    {
        "type": "custom",
        "format": "┌───────────────────── Hardware ─────────────────────┐", // `\u001b` is `\033`, or `\e`
        "outputColor": "cyan"
    },
    {
        "type": "title",
        "key": " PC",
        "keyColor": "cyan",
        "format": "{##8fbcbb}{user-name}{#0}@{##8fbcbb}{host-name}"
    },
    {
        "type": "display",
        "key": "│ ├󰍹 Display",
        "keyColor": "cyan"
    },
    {
      "key": "│ ├ CPU",
      "format": "{1}",
        "keyColor": "cyan",
      "type": "cpu"
    },
    {
      "key": "│ ├󰢮 GPU",
        "keyColor": "cyan",
      "type": "gpu"
    },
    {
      "key": "└ └ Memory",
        "keyColor": "cyan",
      "type": "memory",
      "format": "{used} / {total} "
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘", // `\u001b` is `\033`, or `\e`
        "outputColor": "cyan"
    }
  ]
}
